{
  "name": "donna-admin",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "api": "node server/index.js",
    "local:runtime": "node --env-file=.env scripts/desktop-boot.mjs",
    "local:web": "node --env-file=.env scripts/local_web.mjs",
    "demo:fi": "node scripts/demo_fi.mjs",
    "demo:fi:record": "node scripts/demo_fi.mjs --record",
    "demo:fi:load": "node --env-file=.env scripts/load_finnish_demo.mjs",
    "pilot:fi:prepare": "node scripts/prepare_finnish_hosted_pilot.js",
    "pilot:fi:audit": "node scripts/audit_hosted_pilot_parity.js",
    "dev": "vite",
    "dev:inngest": "npx --yes inngest-cli@latest dev --port 8288 --no-discovery -u http://127.0.0.1:8787/api/inngest",
    "dev:all": "echo \"Run in separate terminals: 'npm run api' (port 8787), 'npm run dev' (port 5173), 'npm run dev:inngest' (port 8288).\"",
    "build": "vite build",
    "mcpb:validate": "npx --yes @anthropic-ai/mcpb@2.1.2 validate desktop/mcpb/manifest.json",
    "mcpb:pack": "npx --yes @anthropic-ai/mcpb@2.1.2 pack desktop/mcpb dist/donna-books.mcpb",
    "vercel-build": "node scripts/vercel-build.js",
    "db:prepare:ci-host": "node scripts/prepare_ci_host_postgres.js",
    "db:migrate": "node scripts/migrate_firm_db.js",
    "db:reset:fresh-onboarding": "node scripts/reset_firm_fresh_onboarding.js",
    "db:seed": "node scripts/seed_firm_db.js",
    "ledger:simulate": "node scripts/simulate_local_ledger_immutability.js",
    "preview": "vite preview",
    "eval:gate2a": "node scripts/eval_world_birth_to_parse.js",
    "eval:ae7": "node scripts/eval_world_ae_whole_period.js",
    "eval:ae7:runtime": "node scripts/eval_world_ae_runtime.js",
    "test:ae7:runtime": "node --test scripts/eval_world_ae_runtime.test.js",
    "eval:gate2b": "node scripts/eval_world_birth_to_quiescence.js",
    "runtime:initialize:ci-host": "node scripts/initialize_ci_host_scheduler.js",
    "certify:host": "node scripts/host_certificate_a.js",
    "certify:entity": "node scripts/entity_certificate_b.js",
    "test:e2e:close": "node scripts/run_close_e2e_synthetic.js",
    "test:ae-accounting-admission": "node --test server/donna/clientAccountingProfile.test.js server/donna/aeAccountingAdmissionPgLifecycle.test.js",
    "test:coding-corrections": "node --test server/donna/codingCorrectionPgLifecycle.test.js",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.17",
    "@vercel/analytics": "^1.6.1",
    "bidi-js": "^1.0.3",
    "fontkit": "^2.0.4",
    "inngest": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intl": "^10.1.25",
    "stripe": "^17.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@vitejs/plugin-react": "^4.2.1",
    "esbuild": "^0.21.5",
    "jsdom": "^26.1.0",
    "pdfjs-dist": "^5.4.624",
    "supabase": "^2.98.1",
    "vite": "^5.0.8"
  }
}
